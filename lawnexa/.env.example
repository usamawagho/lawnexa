# Copy to .env for local development; never commit real credentials.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-unique-secret-at-least-32-characters-long
DATABASE_URL=sqlite:///./lawnexa.db
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,https://lawnexa.vercel.app
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=LawNexa Administrator

# Email password reset (SMTP). Configure a verified sending mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Safepay payment gateway: use sandbox first, never commit real credentials.
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_INTENT=CYBERSOURCE
FRONTEND_URL=https://lawnexa.vercel.app
