# Copy to .env for local development; never commit real credentials.
# Local development generates an ephemeral key when this is blank; deployments must set a unique 32+ character key.
ENVIRONMENT=development
SECRET_KEY=
DATABASE_URL=sqlite:///./lawnexa.db
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,https://lawnexa.vercel.app
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=LawNexa Administrator


# Phase 5 — Safepay sandbox only. Obtain these from your Safepay sandbox dashboard.
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_REDIRECT_URL=https://lawnexa.vercel.app/?payment=return
SAFEPAY_CANCEL_URL=https://lawnexa.vercel.app/?payment=cancelled
