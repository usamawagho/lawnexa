# Server Runtime
PORT=8000
ALLOWED_ORIGINS=https://lawnexa-staging.vercel.app,http://localhost:3000

# Security Secrets
SECRET_KEY=replace_with_your_secret_key
ADMIN_PHONE=replace_with_admin_phone
ADMIN_PASSWORD=replace_with_admin_password

# Staging Managed Database (Render / Supabase / Neon)
DATABASE_URL=replace_with_your_database_url

# Object Storage (AWS S3)
S3_BUCKET_NAME=replace_with_your_bucket_name
AWS_ACCESS_KEY_ID=replace_with_your_aws_access_key
AWS_SECRET_ACCESS_KEY=replace_with_your_aws_secret_key

# Gemini AI API
GEMINI_API_KEY=replace_with_your_gemini_api_key